# Copia questo file in secrets.yaml e inserisci i tuoi valori
# secrets.yaml è in .gitignore e NON deve essere committato

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"
wifi_ssid_backup: "YOUR_BACKUP_WIFI_SSID"
wifi_password_backup: "YOUR_BACKUP_WIFI_PASSWORD"
fallback_ap_password: "connectyourlife-setup"
api_encryption_key: "GENERA_CON: python3 -c 'import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())'"
ota_password: "YOUR_OTA_PASSWORD"
